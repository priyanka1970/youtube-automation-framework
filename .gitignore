# LOCAL FRAMEWORK SAFETY RULES

# Environment files and secrets
.env
.env.*
!/.env.example
!**/.env.example
**/secrets/
**/*credentials*.json
**/*service-account*.json
*.pem
*.key
*.p12
*.pfx

# Google Chrome profiles and login sessions
production/.chrome-profile*/

# Generated videos, narration, screenshots and diagnostic outputs
production/outputs/
*.mp4
*.wav
*.mp3
*.m4a
*.webm

# Dependencies, temporary files and local backups
node_modules/
**/node_modules/
*.log
*.tmp
**/*.backup-*
**/*.bak
Thumbs.db
.DS_Store

# Exclude local backups and temporary diagnostic probes
**/*.backup*
**/*.bak*
**/*_old.py
**/tmp_*probe*.py

